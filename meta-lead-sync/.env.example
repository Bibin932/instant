# Meta Page to sync. The Page access token is read from the existing parent .env:
# META_PAGE_TOKENS_JSON={"PAGE_ID":"PAGE_ACCESS_TOKEN"}
META_PAGE_ID=1289740787545968
META_GRAPH_VERSION=v27.0

# Safe testing: retrieve Meta leads but do not send anything to the CRM.
DRY_RUN=true
POLL_INTERVAL_SECONDS=60
SYNC_HISTORICAL_LEADS=false
SYNC_TEST_LEADS=true
MAX_PAGES_PER_FORM=10
HEALTH_PORT=3111

# CRM API: one lead is submitted per POST using the tableName + data[] contract.
CRM_API_URL=https://likv34svlb.execute-api.ap-south-1.amazonaws.com/prod/create-online-leads
CRM_API_METHOD=POST
CRM_PAYLOAD_MODE=online_leads
CRM_TABLE_NAME=OnlineLeads-qr2mdczhwfhc7nmmkiafsfjlui-prod
CRM_ASSIGNED_TO=1572c311-936b-42d3-a829-67041840d5b4
CRM_FORM_TYPE=LANGUAGE

# These values are only fallbacks. Leave blank until you decide the correct
# default for your lead form. Form answers take precedence when present.
CRM_CAMPAIGN_NAME=
CRM_DEFAULT_LANGUAGE=
CRM_DEFAULT_COURSE=
CRM_DEFAULT_REMARKS=
CRM_HIDE_LEAD=false

# Your supplied CRM examples duplicate the full name in firstName and lastName.
# Set false only if the CRM owner confirms it expects the name split.
CRM_DUPLICATE_FULL_NAME_IN_FIRST_LAST=true

# The supplied endpoint example did not show authentication. Leave blank unless
# the API owner confirms an API key/Bearer token is required.
CRM_BEARER_TOKEN=
CRM_HEADERS_JSON={}
CRM_TIMEOUT_MS=20000
