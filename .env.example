# Server
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://leadsync.yourdomain.com
TRUST_PROXY=1

# Meta app credentials (keep these server-side)
META_APP_SECRET=PASTE_META_APP_SECRET_HERE
META_VERIFY_TOKEN=GENERATE_A_LONG_RANDOM_VALUE
META_GRAPH_VERSION=v27.0
META_PAGE_ACCESS_TOKEN=PASTE_PAGE_ACCESS_TOKEN_HERE
# Optional: for multiple Pages, add a JSON map of Page ID to Page Access Token.
# Example: {"123456789":"PAGE_TOKEN_1","987654321":"PAGE_TOKEN_2"}
META_PAGE_TOKENS_JSON={}

# Existing CRM endpoint and authentication.
CRM_API_URL=https://likv34svlb.execute-api.ap-south-1.amazonaws.com/prod/create-online-leads
CRM_API_KEY=PASTE_YOUR_EXISTING_CRM_API_KEY_HERE
# AWS API Gateway commonly uses x-api-key. IMPORTANT: match the exact working Postman header.
CRM_AUTH_HEADER=x-api-key
# Leave blank for x-api-key. For Authorization: Bearer <key>, set header=Authorization and prefix=Bearer 
CRM_AUTH_PREFIX=
CRM_EXTRA_HEADERS_JSON={}

# Exact CRM payload constants supplied in your example
CRM_TABLE_NAME=OnlineLeads-qr2mdczhwfhc7nmmkiafsfjlui-prod
CRM_ASSIGNED_TO=1572c311-936b-42d3-a829-67041840d5b4
CRM_CAMPAIGN_NAME_DEFAULT=Meta Lead Ads
CRM_FORM_TYPE=LANGUAGE
CRM_PREFERRED_LANGUAGE=English
CRM_HIDE_LEAD=false

# Admin dashboard credentials (setup.js generates ADMIN_PASSWORD if unset)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# Queue and retry settings
MAX_RETRIES=8
RETRY_BASE_DELAY_MS=5000
JOB_RETENTION_DAYS=30

# Meta lead field names can vary by Instant Form. These aliases cover common labels.
# Optional custom aliases can be set as JSON, e.g. {"interestedCourse":["course applied for","degree"]}
META_FIELD_ALIASES_JSON={}
