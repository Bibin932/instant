# Meta Page to sync. The Page access token is read from the existing parent .env:
# META_PAGE_TOKENS_JSON={"PAGE_ID":"PAGE_ACCESS_TOKEN"}
META_PAGE_ID=1289740787545968
META_GRAPH_VERSION=v27.0

# Run in dry-run mode first. It retrieves leads but sends nothing to the CRM.
DRY_RUN=true
POLL_INTERVAL_SECONDS=60

# First run defaults to new leads created after service startup.
# Set true only if you intentionally want to import the existing form history.
SYNC_HISTORICAL_LEADS=false

# Meta's Lead Ads Testing Tool sample leads are excluded by default.
SYNC_TEST_LEADS=false

MAX_PAGES_PER_FORM=10
HEALTH_PORT=3111

# CRM details. Keep DRY_RUN=true until these are configured and tested.
CRM_API_URL=
CRM_API_METHOD=POST
CRM_BEARER_TOKEN=
CRM_HEADERS_JSON={}

# Optional mapping from standard source keys to your CRM's field/property names.
# Example: {"full_name":"name","email":"email_address","phone_number":"mobile"}
CRM_FIELD_MAP_JSON={}
CRM_STATIC_FIELDS_JSON={}
CRM_TIMEOUT_MS=20000
