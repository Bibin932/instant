PORT=3000
# Protects the admin dashboard and /api/admin/* routes. Use a long random string.
ADMIN_KEY=change-me-to-a-long-random-string

# ============ DATABASE (PostgreSQL / Supabase) ============
# Supabase dashboard > Connect > copy the "Session pooler" connection string (works on IPv4 servers like most VPS).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# ============ LLM (the model that writes answers) ============
# OPTION A: paid, best quality (Claude)
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-your-key
LLM_MODEL=claude-haiku-5-5

# OPTION B: zero-cost. Comment out Option A and use ONE of these.
# Any OpenAI-compatible endpoint works. Check each provider's docs for current free-tier limits and model names.
#
# Groq (free tier):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_key
# LLM_MODEL=llama-3.3-70b-versatile
#
# Google Gemini (free tier):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_key
# LLM_MODEL=gemini-2.0-flash
#
# Ollama (runs on your own machine, fully free, no key):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# ============ EMBEDDINGS (how PDFs/pages are indexed) ============
# local = free, runs inside Node, no key (downloads a small model on first use)
EMBED_PROVIDER=local
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2
#
# Paid, higher quality:
# EMBED_PROVIDER=voyage
# EMBED_API_KEY=pa-your-key
# EMBED_MODEL=voyage-3.5-lite
#
# OpenAI-compatible (OpenAI, or Ollama for free):
# EMBED_PROVIDER=openai-compatible
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=nomic-embed-text

# ============ Behaviour & cost controls ============
MAX_TOKENS=500
TOP_K=5
# Below this similarity the bot skips the LLM and uses the fallback reply (saves cost)
MIN_SCORE=0.25
DAILY_MESSAGE_LIMIT=500
RATE_PER_MIN=20
