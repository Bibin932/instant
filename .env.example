PORT=3000
BASE_URL=http://localhost:3000
ADMIN_KEY=replace-this-with-a-long-random-secret
MAX_FILE_MB=250

# Optional FTP receiver. Run `npm run ftp` separately.
FTP_HOST=0.0.0.0
FTP_PORT=2121
FTP_USER=event-uploader
FTP_PASSWORD=change-this-password
FTP_ROOT=./data/uploads

# Optional Google Drive backup (service account JSON path and folder ID).
# Keep credentials out of source control. Share the destination Drive folder
# with the service account email. Uploaded files remain private in Drive.
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_BACKUP=false
