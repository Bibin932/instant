PORT=3000
BASE_URL=https://faces.cybercodix.com
ADMIN_KEY=Codix@2k26
MAX_FILE_MB=250

# ---- AI face recognition (REQUIRED for selfie search) ----
# Address of your face-recognition service (needs POST /index and POST /search).
AI_API_URL=http://127.0.0.1:8090
# Must be identical to the token your AI service expects (sent as "Bearer <token>").
AI_SERVICE_TOKEN=Codix@2k26

# Optional camera FTP receiver; run `npm run ftp` as a separate process.
# Use a dedicated receiver host/VPS or a laptop relay. Shared web hosting often blocks custom FTP ports.
FTP_HOST=0.0.0.0
FTP_PORT=2121
FTP_USER=event-uploader
FTP_PASSWORD=replace-with-a-long-random-password
FTP_EVENT_ID=wedding-demo
FTP_ROOT=./data/ftp-inbox
UPLOADS_ROOT=./data/uploads
# Set to the receiver's public IP/DNS name when camera connects over the internet.
FTP_PASV_URL=
FTP_PASV_MIN=40000
FTP_PASV_MAX=40100
FTP_POLL_MS=3000

# Optional Google Drive backup (service account JSON path and folder ID).
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_BACKUP=false
